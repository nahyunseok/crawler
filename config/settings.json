{
    "min_width": 100,
    "min_height": 100,
    "ext_jpg": true,
    "ext_png": true,
    "ext_webp": true,
    "ext_gif": false,
    "ext_allow_base64": true,
    "exclude_keywords": "logo, icon, button, tracker, pixel, banner",
    "include_keywords": "",
    "max_image_mb": 20,
    "headless": true,
    "timeout": 30,
    "user_agent_rotation": true,
    "random_delay_min": 1.0,
    "random_delay_max": 2.0,
    "delay_level": 2.0,
    "respect_robots": true,
    "use_resume": true,
    "manual_login": false,
    "login_wait": 30,
    "use_pagination": true,
    "pagination_selector": "",
    "max_pagination_pages": 30,
    "allowed_extensions": [
        ".jpg",
        ".jpeg",
        ".png",
        ".webp"
    ],
    "max_scrolls": 0
}